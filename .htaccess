# Комікс·Lab — правила для теки сайту (comiks/). Батьківський сайт не зачіпаються:
# усе нижче діє лише всередині цієї теки.

# Не показувати вміст тек тому, хто зайшов за адресою без файла.
Options -Indexes

<IfModule mod_headers.c>
  # Браузер не має «вгадувати» тип файла — так не вийде видати картинку за скрипт.
  Header always set X-Content-Type-Options "nosniff"
  # Чужий сайт не дізнається, з якої саме сторінки прийшов відвідувач.
  Header always set Referrer-Policy "same-origin"
  # Сайту не потрібні камера, мікрофон чи місце — крім мікрофона для дзвінка.
  Header always set Permissions-Policy "camera=(), geolocation=(), payment=(), usb=(), microphone=(self)"
  # Сторінки сайту не можна вбудувати в чужий iframe.
  Header always set X-Frame-Options "SAMEORIGIN"
  # Лише https: увесь домен і так перенаправляє http → https, тож браузер може одразу йти на https.
  # Без includeSubDomains — піддомени bilohash.com не зачіпаємо.
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Озвучення й картинки мають незмінні імена — їх можна тримати рік.
  ExpiresByType audio/mpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  # Код і дані запитуються з ?v=<версія>, тож година тут безпечна й швидка.
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
</IfModule>

# Ці три файли вирішують, яку версію побачить відвідувач. Вони завжди свіжі,
# інакше після оновлення люди тижнями сидітимуть на старій збірці.
<FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, must-revalidate"
  </IfModule>
</FilesMatch>

# Робочі файли, яким не місце на бойовому сервері, — навіть якщо їх туди залили.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Людська HTML-карта має коротку URL без розширення. Варіант зі слешем
  # зводимо до одного canonical, а запит без слеша внутрішньо віддає файл.
  RewriteRule ^sitemap/$ /comiks/sitemap [R=301,L]
  RewriteRule ^sitemap$ sitemap.html [L]
  RewriteRule ^(_private|tools|tests|node_modules)(/|$) - [F,L]
</IfModule>

# Тека зі складальними скриптами й чернетками не віддається за жодних умов.
<FilesMatch "\.(md|py|bat|jks|properties|env|log|sql)$">
  Require all denied
</FilesMatch>

# Журнал оновлень: номери записів вирівняно на справжні дати публікації.
# Старі адреси вже розійшлися посиланнями, тож ведемо їх на нові назавжди,
# а не віддаємо 404.
Redirect 301 /comiks/updates/2026-10-03/ /comiks/updates/2026-10-02-2/
Redirect 301 /comiks/uk/onovlennya/2026-10-03/ /comiks/uk/onovlennya/2026-10-02-2/
Redirect 301 /comiks/no/oppdateringer/2026-10-03/ /comiks/no/oppdateringer/2026-10-02-2/
Redirect 301 /comiks/updates/2026-10-04/ /comiks/updates/2026-10-02-3/
Redirect 301 /comiks/uk/onovlennya/2026-10-04/ /comiks/uk/onovlennya/2026-10-02-3/
Redirect 301 /comiks/no/oppdateringer/2026-10-04/ /comiks/no/oppdateringer/2026-10-02-3/
Redirect 301 /comiks/updates/2026-10-05/ /comiks/updates/2026-10-02-4/
Redirect 301 /comiks/uk/onovlennya/2026-10-05/ /comiks/uk/onovlennya/2026-10-02-4/
Redirect 301 /comiks/no/oppdateringer/2026-10-05/ /comiks/no/oppdateringer/2026-10-02-4/
Redirect 301 /comiks/updates/2026-10-06/ /comiks/updates/2026-10-03-1/
Redirect 301 /comiks/uk/onovlennya/2026-10-06/ /comiks/uk/onovlennya/2026-10-03-1/
Redirect 301 /comiks/no/oppdateringer/2026-10-06/ /comiks/no/oppdateringer/2026-10-03-1/
Redirect 301 /comiks/updates/2026-10-07/ /comiks/updates/2026-10-03-2/
Redirect 301 /comiks/uk/onovlennya/2026-10-07/ /comiks/uk/onovlennya/2026-10-03-2/
Redirect 301 /comiks/no/oppdateringer/2026-10-07/ /comiks/no/oppdateringer/2026-10-03-2/

# Корінь мовної теки (/comiks/uk/, /comiks/de/ …) не має власної сторінки, тож
# сервер віддавав 403 — глухий кут і для людини, і для пошуковика. Ведемо на
# головну сторінку тієї самої мови.
# Саме RedirectMatch із якорем: звичайний Redirect збігається за префіксом і
# потягнув би за собою всі /comiks/uk/komiks/… на неіснуючі адреси.
RedirectMatch 301 ^/comiks/(uk|no|de|pl|tr|lt|ar)/?$ /comiks/$1/komiks/
